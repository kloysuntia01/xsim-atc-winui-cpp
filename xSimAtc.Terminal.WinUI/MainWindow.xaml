<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="xSimAtc_Terminal_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="xSimAtc.Terminal.WinUI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Orientation="Horizontal"
            Padding="12"
            Spacing="12">

            <TextBlock
                VerticalAlignment="Center"
                FontSize="24"
                Text="{Binding Title}" />

            <Button
                Content="Tower"
                Click="OnTowerClick" />

            <Button
                Content="Trackings"
                Click="OnTrackingsClick" />
        </StackPanel>

        <ContentControl
            Grid.Row="1"
            Content="{Binding SelectedView.Content}" />
    </Grid>
</Window>
