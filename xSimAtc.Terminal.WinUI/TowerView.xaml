<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="xSimAtc_Terminal_WinUI.TowerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="520"
            Spacing="12"
            Padding="24">

            <TextBlock
                FontSize="28"
                Text="Tower" />

            <TextBlock Text="{Binding TowerGuid}" />

            <TextBlock
                FontSize="20"
                Text="{Binding PendingMessage}" />

            <Button
                Content="Send N123 to Msg.Q"
                Click="OnSendClick" />

            <TextBlock Text="{Binding LastMessage}" />

            <Border
                Margin="0,20,0,0"
                Padding="16"
                BorderThickness="1"
                CornerRadius="8"
                AutomationProperties.AutomationId="TowerAdvisorySmokePanel">

                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="ATC Advisory UI Smoke" />

                    <TextBlock
                        Text="Runway 18R: Occupied"
                        AutomationProperties.AutomationId="TowerAdvisoryRunwayStatus" />

                    <TextBlock
                        Text="FDX606: Holding Short"
                        AutomationProperties.AutomationId="TowerAdvisoryAircraftStatus" />

                    <Button
                        Content="Request Advisory"
                        Click="OnRequestAdvisoryClick"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="TowerRequestAdvisoryButton" />

                    <TextBlock
                        Text="{Binding AdvisoryStatus}"
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="TowerAdvisoryStatusText" />

                    <TextBlock
                        Text="{Binding AdvisoryText}"
                        TextWrapping="Wrap"
                        FontWeight="SemiBold"
                        AutomationProperties.AutomationId="TowerAdvisoryText" />

                    <TextBlock
                        Text="{Binding AdvisoryMutationStatus}"
                        AutomationProperties.AutomationId="TowerAdvisoryMutationStatus" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
