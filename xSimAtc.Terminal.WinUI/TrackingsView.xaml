<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="xSimAtc_Terminal_WinUI.TrackingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock
                FontSize="28"
                Text="{Binding Title}" />
            <TextBlock
                Opacity="0.7"
                Text="{Binding Status}" />
        </StackPanel>

        <Viewbox
            Grid.Row="1"
            Stretch="Uniform"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <!-- Virtual tracking space is exactly 500 x 500 units. -->
            <Grid Width="500" Height="500">

                <Ellipse
                    Width="470"
                    Height="470"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    StrokeThickness="2"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}" />

                <Ellipse
                    Width="300"
                    Height="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    StrokeThickness="1"
                    Opacity="0.35"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}" />

                <Line
                    X1="250" Y1="15"
                    X2="250" Y2="485"
                    StrokeThickness="1"
                    Opacity="0.35"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}" />

                <Line
                    X1="15" Y1="250"
                    X2="485" Y2="250"
                    StrokeThickness="1"
                    Opacity="0.35"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="22"
                    Text="N" />

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="22"
                    Text="S" />

                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Text="W" />

                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Text="E" />

                <ItemsControl ItemsSource="{Binding Aircraft}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="500" Height="500" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5">

                                <StackPanel.RenderTransform>
                                    <TranslateTransform
                                        X="{Binding X}"
                                        Y="{Binding Y}" />
                                </StackPanel.RenderTransform>

                                <Ellipse
                                    Width="9"
                                    Height="9"
                                    Fill="{ThemeResource TextFillColorPrimaryBrush}" />

                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding CallSign}" />

                                    <TextBlock
                                        FontSize="9"
                                        Opacity="0.65"
                                        Text="{Binding FakeGuid}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Viewbox>
    </Grid>
</Page>
